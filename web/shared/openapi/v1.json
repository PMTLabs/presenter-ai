{
  "openapi": "3.1.1",
  "info": {
    "title": "PresenterAi.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:47913/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "PresenterAi.Api"
        ],
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "PresenterAi.Api"
        ],
        "operationId": "GetConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/presentations": {
      "get": {
        "tags": [
          "PresentationEndpoints"
        ],
        "operationId": "ListPresentations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PresentationSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/presentations/{id}": {
      "get": {
        "tags": [
          "PresentationEndpoints"
        ],
        "operationId": "GetPresentation",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresentationDetail"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigDto": {
        "required": [
          "model",
          "voice",
          "advanceSilenceMs"
        ],
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          },
          "advanceSilenceMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PresentationDetail": {
        "required": [
          "id",
          "meta",
          "slides",
          "hasContext"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/PresentationMetaDto"
          },
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlideDto"
            }
          },
          "hasContext": {
            "type": "boolean"
          }
        }
      },
      "PresentationMetaDto": {
        "required": [
          "id",
          "title",
          "deck",
          "driver",
          "voice",
          "context",
          "advanceSilenceMs",
          "chunkChars"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "deck": {
            "type": "string"
          },
          "driver": {
            "type": "string"
          },
          "voice": {
            "type": [
              "null",
              "string"
            ]
          },
          "context": {
            "type": [
              "null",
              "string"
            ]
          },
          "advanceSilenceMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "chunkChars": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PresentationSummary": {
        "required": [
          "id",
          "title",
          "slideCount",
          "deck",
          "driver",
          "error"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slideCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "deck": {
            "type": [
              "null",
              "string"
            ]
          },
          "driver": {
            "type": [
              "null",
              "string"
            ]
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SlideDto": {
        "required": [
          "index",
          "number",
          "title",
          "narration",
          "notes"
        ],
        "type": "object",
        "properties": {
          "index": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "PresenterAi.Api"
    },
    {
      "name": "PresentationEndpoints"
    }
  ],
