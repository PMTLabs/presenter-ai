# Upstream GPT-Live endpoint. Base URL only, or a full .../live/sessions URL.
#   Azure AI Foundry:  https://<resource>.services.ai.azure.com   -> wss://.../openai/v1/live/sessions
#   Azure OpenAI:      https://<resource>.openai.azure.com        -> wss://.../openai/v1/live/sessions
#   OpenAI direct:     https://api.openai.com                     -> wss://api.openai.com/v1/live/sessions
UPSTREAM_ENDPOINT=https://your-resource.services.ai.azure.com
UPSTREAM_KEY=your-api-key
# Optional OpenAI fallback used when the primary upstream refuses a session (rate limit, outage).
# FALLBACK_OPENAI_KEY=your-openai-key

# JWT signing key for the full compose profile. Generate 32+ random bytes; never commit a value.
JWT_SECRET_KEY=

# Model id (OpenAI) or deployment name (Azure). Default: gpt-live-1
# UPSTREAM_MODEL=gpt-live-1
# Output voice. Default: marin
# UPSTREAM_VOICE=marin
# Model that answers audience questions the deck does not cover: model id (OpenAI) or deployment name (Azure,
# same resource as GPT-Live). Set to empty for deck-only answers. If the model is unavailable, the session starts
# deck-only and logs why. Default: gpt-5.6-luna
# UPSTREAM_DELEGATION_MODEL=gpt-5.6-luna
# The same for the OpenAI fallback upstream. Default: gpt-5.6-luna
# FALLBACK_DELEGATION_MODEL=gpt-5.6-luna

# .NET host URL (use ASPNETCORE_URLS or Kestrel__Endpoints__Http__Url). Default: http://localhost:47913
# ASPNETCORE_URLS=http://localhost:47913
# Kestrel__Endpoints__Http__Url=http://localhost:47913
# Silence (ms) after the model stops speaking before the next slide is shown. Default: 3000
# (the model pauses up to ~2.3 s at paragraph breaks; below 2500 it may advance mid-slide)
# ADVANCE_SILENCE_MS=3000
# Set to true to log every upstream JSON event (audio deltas excluded). Node accepted 1/0; the .NET host binds true/false.
# LOG_EVENTS=false
